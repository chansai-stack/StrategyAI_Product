{
  "name": "StratAI - Slack Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stratai-slack-notify",
        "responseMode": "lastNode"
      },
      "id": "webhook-slack",
      "name": "Webhook - Slack Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body || $input.first().json;\n\nreturn {\n  json: {\n    report_id: data.report_id || '',\n    company_name: data.company_name || '',\n    confidence_score: data.confidence_score || '',\n    strategic_question: data.strategic_question || '',\n    google_doc_url: data.google_doc_url || '',\n    user_email: data.user_email || '',\n    slack_channel: data.slack_channel || '#stratai-reports',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "extract-slack-data",
      "name": "Extract Slack Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{ $json.slack_channel }}",
        "text": "=New StratAI Strategic Analysis Complete",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "🎯 Strategic Analysis Complete"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Company:* {{ $json.company_name }}\\n*Report ID:* `{{ $json.report_id }}`\\n*Confidence Score:* {{ $json.confidence_score }}%"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Strategic Question:*\\n{{ $json.strategic_question }}"
              }
            },
            {
              "type": "divider"
            },
            {
              "type": "context",
              "elements": [
                {
                  "type": "mrkdwn",
                  "text": "Generated by StratAI Multi-Agent Analysis Platform"
                }
              ]
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "📄 View Report"
                  },
                  "url": "{{ $json.google_doc_url }}",
                  "style": "primary"
                }
              ]
            }
          ]
        },
        "otherOptions": {}
      },
      "id": "post-slack-message",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [650, 300],
      "credentials": {
        "slackOAuth2Api": {
          "id": "6",
          "name": "Slack OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"slack_posted\": true, \"channel\": $json.slack_channel } }}"
      },
      "id": "respond-slack",
      "name": "Respond Slack Posted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook - Slack Trigger": {
      "main": [[{"node": "Extract Slack Data", "type": "main", "index": 0}]]
    },
    "Extract Slack Data": {
      "main": [[{"node": "Post to Slack", "type": "main", "index": 0}]]
    },
    "Post to Slack": {
      "main": [[{"node": "Respond Slack Posted", "type": "main", "index": 0}]]
    }
  }
}
